# =============================================================================
# StudioOS API — environment template
# Copy to .env and fill in real values. Never commit .env.
#
# In staging/prod, this file lives at /srv/studioos/server/.env on the VPS,
# written by hand from the Bitwarden secure note "studioos-st-env".
# =============================================================================


# ── Django core ───────────────────────────────────────────────────────────────

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# False in any non-dev environment
DEBUG=False

# Comma-separated list. Must include all hosts that hit Django directly.
# Staging:  st.studioos.club,api.st.studioos.club
# Local:    localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1


# ── CORS ──────────────────────────────────────────────────────────────────────

# Comma-separated origins (scheme+host+port, no trailing slash).
# Only needed if the SPA calls the API on a different origin.
# When using Caddy same-origin routing under st.studioos.club, this can stay
# empty in staging (frontend uses relative /api).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000


# ── Database (Postgres) ───────────────────────────────────────────────────────

DB_ENGINE=django.db.backends.postgresql
DB_NAME=studioos
DB_USER=studioos
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# Consumed by the postgres image itself (must match DB_* above)
POSTGRES_DB=studioos
POSTGRES_USER=studioos
POSTGRES_PASSWORD=


# ── JWT ───────────────────────────────────────────────────────────────────────

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7


# ── Email ─────────────────────────────────────────────────────────────────────

# Local dev: django.core.mail.backends.console.EmailBackend (prints to stdout)
# With mailpit: django.core.mail.backends.smtp.EmailBackend + EMAIL_HOST=mailpit
# Staging/prod: same SMTP backend pointing to a real provider (Brevo/Mailgun/Resend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@studioos.dev


# ── URLs (used in email templates and links) ──────────────────────────────────

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000


# ── Celery + Redis ────────────────────────────────────────────────────────────

# Service name "redis" resolves inside the docker compose network.
# DB 0 = Celery broker/results, DB 1 = invite tokens, DB 2 = Channels layer.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
INVITE_REDIS_URL=redis://redis:6379/1
CHANNEL_LAYERS_REDIS_URL=redis://redis:6379/2


# ── Business rules ────────────────────────────────────────────────────────────

# Hours before a coaching's start_datetime within which a cancellation
# counts as "late" (becomes fine candidate).
COACHING_LATE_CANCELLATION_HOURS=48

# Default fine amount (EUR) shown to coordination at fine-approval time.
COACHING_FINE_DEFAULT_AMOUNT=25.00

# Reminder windows for WAITING_CONFIRMATION coachings.
# Comma-separated "hours_after_end:is_final" pairs.
COACHING_REMINDER_WINDOWS=24:0,42:1

# Edit window for a user's own messages (minutes).
MESSAGE_EDIT_WINDOW_MINUTES=15


# ── CSRF (staging / prod only) ────────────────────────────────────────────────

# Comma-separated list of origins allowed to send POST/PUT/DELETE.
# MUST include the full scheme (https://). Required when the SPA submits forms
# from an HTTPS origin — without this, Django returns 403 "CSRF verification
# failed; Origin header doesn't match any trusted origin".
#
# Staging: https://st.studioos.club,https://api.st.studioos.club
# Local:   leave empty (DEBUG=True bypasses these checks)
CSRF_TRUSTED_ORIGINS=

# -----------------------------------------------------------------------------
# The following are derived automatically from DEBUG by settings.py and do NOT
# need env entries:
#   SECURE_PROXY_SSL_HEADER  →  always ("HTTP_X_FORWARDED_PROTO", "https")
#   USE_X_FORWARDED_HOST     →  always True
#   SESSION_COOKIE_SECURE    →  not DEBUG
#   CSRF_COOKIE_SECURE       →  not DEBUG
#   SESSION_COOKIE_SAMESITE  →  "Lax"
#   CSRF_COOKIE_SAMESITE     →  "Lax"
# -----------------------------------------------------------------------------
