# =============================================================================
# StudioOS API — environment template
# =============================================================================


# ── Django ────────────────────────────────────────────────────────────────────

SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1


# ── CORS / CSRF ───────────────────────────────────────────────────────────────

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=


# ── Database ──────────────────────────────────────────────────────────────────

DB_ENGINE=django.db.backends.postgresql
DB_NAME=studioos
DB_USER=studioos
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

POSTGRES_DB=studioos
POSTGRES_USER=studioos
POSTGRES_PASSWORD=


# ── JWT ───────────────────────────────────────────────────────────────────────

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7


# ── Email ─────────────────────────────────────────────────────────────────────

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@studioos.dev


# ── URLs ──────────────────────────────────────────────────────────────────────

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000


# ── Celery / Redis ────────────────────────────────────────────────────────────

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
INVITE_REDIS_URL=redis://redis:6379/1
CHANNEL_LAYERS_REDIS_URL=redis://redis:6379/2


# ── Business rules ────────────────────────────────────────────────────────────

COACHING_LATE_CANCELLATION_HOURS=48
COACHING_FINE_DEFAULT_AMOUNT=25.00
COACHING_REMINDER_WINDOWS=24:0,42:1
MESSAGE_EDIT_WINDOW_MINUTES=15
