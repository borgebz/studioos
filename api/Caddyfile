# =============================================================================
# Caddyfile — staging (st.studioos.club + api.st.studioos.club)
#
# Caddy automatically:
#  - obtains and renews Let's Encrypt certs for the domains below
#  - redirects HTTP → HTTPS
#  - enables HTTP/2 and HTTP/3
#  - sends X-Forwarded-* headers to upstreams
# =============================================================================

# Global options
{
    # Replace with a real address when you want LE expiry warnings by email
    # email admin@studioos.club
}


# -----------------------------------------------------------------------------
# Primary host: SPA + same-origin API proxy (no CORS needed for the frontend)
# -----------------------------------------------------------------------------
st.studioos.club {
    encode zstd gzip

    # Django static (collectstatic output) — served by Caddy directly
    handle_path /static/* {
        root * /srv/static
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # User-uploaded media — served by Caddy directly
    handle_path /media/* {
        root * /srv/media
        file_server
        header Cache-Control "public, max-age=86400"
    }

    # Django admin
    handle /admin/* {
        reverse_proxy api:8000
    }

    # API (REST)
    handle /api/* {
        reverse_proxy api:8000
    }

    # WebSockets (Django Channels)
    handle /ws/* {
        reverse_proxy api:8000
    }

    # Everything else → SPA (React)
    handle {
        reverse_proxy web:80
    }
}


# -----------------------------------------------------------------------------
# API host: direct access for Postman, Swagger UI, mobile clients
# -----------------------------------------------------------------------------
api.st.studioos.club {
    encode zstd gzip

    handle_path /static/* {
        root * /srv/static
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    handle_path /media/* {
        root * /srv/media
        file_server
        header Cache-Control "public, max-age=86400"
    }

    handle {
        reverse_proxy api:8000
    }
}
